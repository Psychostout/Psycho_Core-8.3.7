########################################
# Psycho_Core mod-psychobot configuration  (Stage 1: Foundation + Main AI)
########################################
#
# Copy to "mod_psychobot.conf" (drop .dist) in your server's configs/modules
# directory, or merge the keys into worldserver.conf. Read via sConfigMgr.
#
[worldserver]

#
#    Psychobot.Enable
#        Description: Master on/off switch for the Psychobot system.
#                     When 0, the world tick and commands do nothing.
#        Default:     0 (disabled)
#
Psychobot.Enable = 0

#
#    Psychobot.FollowDistance
#        Description: (reserved for later stages) yards a bot trails its master.
#        Default:     2.0
#
Psychobot.FollowDistance = 2.0
